# Production build settings.
#
# Deployed builds call the API same-origin, derive the Databricks OAuth redirect from window.location at
# runtime, and fetch the Application Insights connection string from the API (/api/config) at startup. There
# are intentionally NO build-time API / redirect / telemetry URLs here — that is what lets a single build
# artifact be promoted across dev/stg/prd unchanged (build once, deploy many).

# Logging & Telemetry
VITE_DISABLE_APP_INSIGHTS=
VITE_DEBUG_MODE=false
VITE_LOG_TO_CONSOLE=false
VITE_LOG_LEVEL=warn
VITE_LOG_FILTER_MODE=exclude
VITE_LOG_FILTER_LIST=
