# Local development environment variables.
#
# VITE_API_BASE_URL is injected by the Aspire AppHost (local HTTPS API) when running locally, and is only used
# by the Vite dev server. Deployed builds ignore it and call the API same-origin (see src/config/api.ts).
# The Databricks OAuth redirect and the Application Insights connection string are resolved at RUNTIME
# (window origin + the API's /api/config endpoint), not from build-time variables.

VITE_API_BASE_URL = https://xorbix-vdab-dev.azurewebsites.net

# Logging & Telemetry
VITE_DISABLE_APP_INSIGHTS=
VITE_DEBUG_MODE=false
VITE_LOG_TO_CONSOLE=false
VITE_LOG_LEVEL=info
VITE_LOG_FILTER_MODE=exclude
VITE_LOG_FILTER_LIST=
