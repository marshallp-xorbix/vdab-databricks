{
  // Copy this file to appsettings.Local.json (git-ignored) for machine-specific AppHost overrides.
  // It is loaded last, so it wins over appsettings.json, appsettings.Development.json, and Key Vault.
  //
  // This file configures ONLY how the AppHost provisions a database. The connection string the API uses
  // lives in the Server project's appsettings.Local.json — see
  // Xorbix-Visual-Databricks-App-Builder.Server/appsettings.Local.example.json.

  "Database": {
    // false = Aspire owns a local Postgres container (recommended for day-to-day local dev).
    // true  = no container is created; the API connects to whatever the Server's ConnectionStrings:PostgreSql
    //         points at (a shared dev/staging/prod database you want to debug). Migrations are never applied
    //         automatically in this mode.
    "UseExistingDatabase": false,

    // Honored ONLY when UseExistingDatabase = false. true = the MigrationService applies EF migrations and
    // seed data to the local container before the API starts. Set false to start an empty container and apply
    // migrations yourself with `dotnet ef database update`. This flag can never affect an external database.
    "ApplyMigrations": true
  },

  // Credentials / port / volume for the Aspire-managed container. Aspire builds the connection string from
  // these and injects it into the API automatically, so there is nothing to mirror in the Server settings.
  // If the old local-db container still binds 5432, stop it (docker rm -f vdab-postgres) or change Postgres:Port.
  "Parameters": {
    "postgres-password": "postgres"
  },
  "Postgres": {
    "Port": 5432,
    "DataVolumeName": "vdab-pgdata"
  }
}
