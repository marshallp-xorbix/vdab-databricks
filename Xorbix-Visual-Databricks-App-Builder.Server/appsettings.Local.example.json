{
  // Copy this file to appsettings.Local.json (git-ignored) for machine-specific Server overrides.
  // It is loaded last, so it wins over appsettings.json, appsettings.Development.json, and Key Vault.
  //
  // Key Vault still supplies non-database secrets (JWT, Stripe, encryption, etc.) in both modes, so keep
  // the KeyVault:Uri below.
  //
  // Database connection string:
  //   * Aspire-managed local container (AppHost Database:UseExistingDatabase = false): you do NOT set a
  //     connection string here. The AppHost injects the container's connection string automatically (under
  //     ConnectionStrings:AspireInjected, promoted to ConnectionStrings:PostgreSql at startup).
  //   * External / shared database you want to debug (AppHost Database:UseExistingDatabase = true): uncomment
  //     ConnectionStrings:PostgreSql below and point it at that database. Migrations are never applied to it
  //     automatically — run `dotnet ef database update` deliberately if needed.

  "KeyVault": {
    "Uri": "https://xorbixvdabdevkv.vault.azure.net/"
  },

  // Allowlisted internal/dev tenants get complimentary Seats & Users (no Stripe seat purchase).
  // Leave empty in committed files; set real GUIDs only in this local overlay or Azure App Settings.
  "InternalDevTenants": {
    "TenantIds": []
  }

  // "ConnectionStrings": {
  //   "PostgreSql": "Host=your-db-host;Port=5432;Database=vdab-db;Username=postgres;Password=...;SSL Mode=Require"
  // }
}
