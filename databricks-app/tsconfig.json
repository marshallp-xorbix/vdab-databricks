{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "types": ["node"],
    "typeRoots": [
      "./node_modules/@types",
      "../xorbix-visual-databricks-app-builder.client/node_modules/@types"
    ],
    "noEmit": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["server/src/**/*.ts", "server/test/**/*.ts", "scripts/**/*.ts"]
}
