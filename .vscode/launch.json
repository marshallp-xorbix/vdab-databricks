{
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Run Aspire AppHost",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Xorbix-Visual-Databricks-App-Builder.AppHost/bin/Debug/net10.0/Xorbix-Visual-Databricks-App-Builder.AppHost.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Xorbix-Visual-Databricks-App-Builder.AppHost",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "DOTNET_ENVIRONMENT": "Development",
                "ASPIRE_DASHBOARD_OTLP_ENDPOINT_URL": "https://localhost:21123",
                "ASPIRE_RESOURCE_SERVICE_ENDPOINT_URL": "https://localhost:22254",
                "ASPNETCORE_URLS": "https://localhost:17253;http://localhost:15089",
                "DOTNET_LAUNCH_PROFILE": "https"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bLogin to the dashboard at\\s+(https?://\\S+)",
                "uriFormat": "%s"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "Attach to Server",
            "type": "coreclr",
            "request": "attach",
            "processName": "Xorbix-Visual-Databricks-App-Builder.Server"
        }
    ]
}